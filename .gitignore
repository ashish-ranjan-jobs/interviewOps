# Generated output (user content, not tracked by default)
output/*
!output/.gitkeep

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# TypeScript cache
*.tsbuildinfo

# Test coverage
coverage/

# Temp
tmp/
temp/

# InterviewOps Studio local data (runtime, not committed)
.interviewops-studio/
studio-api/.interviewops-studio/

# AI Models & Assistants
CLAUDE.MD
.claude/*
